# Docker环境变量配置（全栈本地部署：MySQL + Express 后端 + Nginx 前端）
# 复制此文件为 .env 并修改相应值

# 应用环境
NODE_ENV=production

# MySQL配置
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=liuyao_db
MYSQL_USER=liuyao_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_PORT=3306

# 数据库初始化策略：
# false（默认，生产推荐）= 仅在数据库为空时初始化，已有数据不会被改动
# true（仅开发/测试）    = 每次启动时 DROP 并按最新 SQL 重建数据库（会清空全部数据！）
DB_RESET_ON_STARTUP=false

# JWT配置
JWT_SECRET=your_jwt_secret_key_here_please_change
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com
# DeepSeek 模型（V4 系列，旧的 deepseek-chat / deepseek-reasoner 将于 2026-07-24 弃用）
# 可选值：deepseek-v4-flash（默认，性价比高）、deepseek-v4-pro（旗舰，推理更强）
DEEPSEEK_MODEL=deepseek-v4-flash

# 服务端口
SERVER_PORT=5000
CLIENT_HTTP_PORT=80
CLIENT_HTTPS_PORT=443

# GitHub Container Registry 配置（用于 GHCR 镜像部署）
# GHCR_REGISTRY=ghcr.io
# GHCR_REPO=your-username/liuyao-divination
# IMAGE_TAG=latest
