# 后端本地开发环境配置（Docker 部署时由 docker-compose.yml 注入，无需此文件）
# 复制为 server/.env 使用

PORT=5000
HOST=0.0.0.0

# MySQL（本地开发默认值，与 docker-compose 中的账号保持一致需自行修改）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=liuyao_db

# JWT
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
